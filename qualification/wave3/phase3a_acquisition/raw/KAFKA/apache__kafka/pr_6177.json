  "title": "KAFKA-7862 & KIP-345 part-1: Add static membership logic to JoinGroup protocol",
  "user": {
    "login": "abbccdda",
    "id": 5845561,
    "node_id": "MDQ6VXNlcjU4NDU1NjE=",
