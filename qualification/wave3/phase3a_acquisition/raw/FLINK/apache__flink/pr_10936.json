  "title": "[FLINK-13689] [Connectors/ElasticSearch] Fix thread leak in Elasticsearch connector when cluster is down",
  "user": {
    "login": "static-max",
    "id": 13963492,
    "node_id": "MDQ6VXNlcjEzOTYzNDky",
