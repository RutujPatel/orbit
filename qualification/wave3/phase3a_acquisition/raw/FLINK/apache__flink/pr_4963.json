    "gists_url": "https://api.github.com/users/bowenli86/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/bowenli86/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/bowenli86/subscriptions",
    "organizations_url": "https://api.github.com/users/bowenli86/orgs",
    "repos_url": "https://api.github.com/users/bowenli86/repos",
